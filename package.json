{
  "name": "mergepilot-mcp",
  "version": "0.1.0",
  "description": "Evidence-backed open-source contribution orchestration for coding agents",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "mergepilot": "dist/cli.js"
  },
  "files": [
    "dist",
    "prompts",
    "docs",
    "examples",
    "LICENSE",
    "README.md"
  ],
  "workspaces": [
    "dashboard"
  ],
  "scripts": {
    "build": "npm run build:server && npm run build:dashboard && node scripts/package-dashboard.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p dashboard/tsconfig.json",
    "test": "vitest run",
    "check": "npm run typecheck && npm test && npm run build",
    "start": "node dist/cli.js",
    "prepack": "npm run build",
    "build:dashboard": "npm run build --workspace=@mergepilot/dashboard",
    "build:server": "tsc -p tsconfig.json",
    "test:browser": "playwright test"
  },
  "dependencies": {
    "@octokit/core": "7.0.6",
    "@octokit/plugin-paginate-rest": "14.0.0",
    "jsonc-parser": "3.3.1",
    "smol-toml": "1.8.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "24.13.3",
    "prettier": "3.9.6",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  },
  "peerDependencies": {
    "@modelcontextprotocol/server": "2.4.0"
  },
  "peerDependenciesMeta": {
    "@modelcontextprotocol/server": {
      "optional": true
    }
  }
}
