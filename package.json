{
  "name": "mergepilot-mcp",
  "version": "0.1.0",
  "description": "Evidence-backed open-source contribution orchestration for coding agents",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ayush-singh-0601/mergepilot-mcp.git"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "coding-agent",
    "github"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/",
    "provenance": false
  },
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "mergepilot": "dist/cli.js"
  },
  "files": [
    "dist",
    "prompts",
    "docs",
    "examples",
    "LICENSE",
    "README.md",
    "CHANGELOG.md"
  ],
  "workspaces": [
    "dashboard"
  ],
  "scripts": {
    "build": "npm run build:server && npm run build:dashboard && node scripts/package-dashboard.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p dashboard/tsconfig.json",
    "test": "vitest run",
    "check": "npm run format:check && npm run typecheck && npm test && npm run build",
    "start": "node dist/cli.js",
    "prepack": "npm run build",
    "build:dashboard": "npm run build --workspace=@mergepilot/dashboard",
    "build:server": "node scripts/clean-dist.mjs && tsc -p tsconfig.json",
    "test:browser": "playwright test",
    "format": "prettier --write src tests scripts dashboard/src *.ts *.json .github/workflows/*.yml",
    "format:check": "prettier --check src tests scripts dashboard/src *.ts *.json .github/workflows/*.yml"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.4.0",
    "@octokit/core": "7.0.6",
    "@octokit/plugin-paginate-rest": "14.0.0",
    "jsonc-parser": "3.3.1",
    "smol-toml": "1.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "24.13.3",
    "prettier": "3.9.6",
    "typescript": "5.9.3",
    "vite": "6.4.5",
    "vitest": "5.0.5"
  },
  "overrides": {
    "source-map-js": "1.2.2"
  }
}
